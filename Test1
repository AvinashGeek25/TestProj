	<!--When Upgrading, just change the Product Id, increment the Version and change output name in properties-->
	<Product Id="$(var.PRODUCT_GUID_MSI_64)"
			 Name="$(var.PRODUCT_APP_NAME)"
			 Language="1033"
			 Version="$(var.VERSION)"
			 Manufacturer="Endor AG Fanatec"
			 UpgradeCode="6313F4B8-ECEF-4001-BC30-C00B81551CD5">
		<!--3DD4F1A8-6911-44DB-B60D-B1A6C87414E2-->
		<!--DO NOT MODIFY! Upgrade Code from the original VS2010 setup-->

		<!--Set all installer info-->
		<Package Keywords="Installer"
				 Description="$(var.PRODUCT_DESCRIPTION)"
				 Manufacturer="Fanatec"
				 Comments="Fanatec is a brand of Endor AG Germany"
				 Platform="x64"
				 InstallerVersion="406"
				 Languages='1033'
				 Compressed="yes"
				 InstallScope="perMachine"/>

		<MajorUpgrade Schedule="afterInstallInitialize" DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
		<MediaTemplate EmbedCab="yes"/>
		<Property Id='DiskPrompt' Value="Fanatec Driver Installation" />
		<PropertyRef Id="NETFRAMEWORK40CLIENT"/>
		<Property Id="REINSTALLMODE" Value="amus" />

		<!--<Property Id="TRAYAPPBUG">
        <ProductSearch Minimum="0" Maximum="8.46.2" UpgradeCode="{3DD4F1A8-6911-44DB-B60D-B1A6C87414E2}"/>
    </Property>-->

		<!--NOTE: TrayApp V0.41 in Driver V451 has bug that prevents it being uninstalled-->
		<Property Id="DRIVERV451TRAYAPPBUG" Secure="yes" />
		<Upgrade Id="{3DD4F1A8-6911-44DB-B60D-B1A6C87414E2}">
			<UpgradeVersion
			Minimum="8.46.2" Maximum="8.46.2"
			Property="DRIVERV451TRAYAPPBUG"
			IncludeMinimum="yes" IncludeMaximum="yes" OnlyDetect="yes" />
		</Upgrade>

		<!--NOTE: Disables the msi checking if device is still in used by various softwares.
              Disabling device still in use will require a reboot after uninstallation.-->
		<!--<Property Id="MSIRESTARTMANAGERCONTROL" Value="Disable" />-->

		<Feature Id="ProductFeature" Title="Fanatec Wheel" Level="1">
			<!--Reference here all Id from the fragments-->
			<ComponentGroupRef Id="ProductComponents_Main" />
			<ComponentGroupRef Id="ProductComponents_Metadata" />
