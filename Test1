			<MergeRef Id="VCRedist"/>
		</Feature>

		<!--<Condition Message="Please Run as Administrator.">
			Privileged
		</Condition>

		<Property Id="MSIUSEREALADMINDETECTION" Value="1" />-->

		<!--Set launch conditions-->
		<Condition Message="This application is only supported on Windows Vista, Windows 7, and higher.">
			<![CDATA[Installed OR (VersionNT >= 600)]]>
		</Condition>

		<Condition Message="Cannot install 64-bit setup on 32-bit machine. Contact your product Vendor for details.">
			<![CDATA[Installed OR VersionNT]]>
		</Condition>

		<Condition Message="This application requires .NET Framework 4.0 Client Profile. Please install the .NET Framework then run this installer again.">
			<![CDATA[Installed OR NETFRAMEWORK40CLIENT]]>
		</Condition>

		<Condition Message="Fanatec Driver Installer has detected that there are pending system changes that require a reboot. Please reboot the system and rerun the installation.">
