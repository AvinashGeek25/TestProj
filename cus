        [CustomAction]
        public static ActionResult ModifyMosquittoConf(Session session)
        {
            try
            {
                string mosquittoConfPath = Path.Combine($@"{Settings.programFilesPath}\mosquitto", "mosquitto.conf");
                string mosquittoConfBackupPath = Path.Combine($@"{Settings.tempPath}", "mosquitto.conf");
                string mosquittoPwdFilePath = Path.Combine($@"{Settings.programFilesPath}\mosquitto", "pwfile.example");

                if (System.IO.File.Exists(mosquittoConfPath))
                {
                    System.IO.File.Copy(mosquittoConfPath, mosquittoConfBackupPath, true);
                    System.IO.File.AppendAllLines(mosquittoConfBackupPath, new[] { "listener 1883 0.0.0.0", "allow_anonymous false", "password_file " + mosquittoPwdFilePath });
                    SetupHelpers.ExecuteEXE("cmd.exe", $"/c copy \"{mosquittoConfBackupPath}\" \"{mosquittoConfPath}\"");
                }

                if (System.IO.File.Exists(mosquittoConfBackupPath))
                    System.IO.File.Delete(mosquittoConfBackupPath);

                var mosquittoService = "mosquitto";
                var installerArgument = $"start {mosquittoService} force";
                SetupHelpers.ExecuteEXE("sc.exe", installerArgument);

                return ActionResult.Success;
            }
            catch (Exception ex)
            {
                session.Log($"ModifyMosquittoConf: Failed to modify mosquitto.conf: {ex.Message}");
                return ActionResult.Failure;
            }
        }

        [CustomAction]
        public static ActionResult InstallFanatecService(Session session)
        {
            try
            {

                string targetPath = session.CustomActionData["InstallPath"];
                string zipFilePath = Path.Combine($@"{targetPath}", "FanatecService", "onefanatec.zip");
                string targetDirectory = Path.Combine($@"{targetPath}", "FanatecService", "Service");

                if (Directory.Exists(targetDirectory))
                {
                    Directory.Delete(targetDirectory, true);
                }
                ZipFile.ExtractToDirectory(zipFilePath, targetDirectory);

                string exeFilePath = Path.Combine($@"{targetDirectory}", "FanatecService.exe");
                bool isExists = false;
                if (System.IO.File.Exists(exeFilePath))
                {
                    isExists = true;
                }
                else if (System.IO.File.Exists(Path.Combine($@"{targetDirectory}", "onefanatec", "FanatecService.exe")))
                {
                    isExists = true;
                    exeFilePath = Path.Combine($@"{targetDirectory}", "onefanatec", "FanatecService.exe");
                }

                if (isExists)
                {
                    SetupHelpers.StopProcess("FanatecService");
                    SetupHelpers.WaitProcessTerminate("FanatecService", 60);
                    AddStartupEntry(session, exeFilePath);
                    return ActionResult.Success;
                }
                else
                {
                    SetupHelpers.StopProcess("FanatecService");
                    RemoveStartupEntry(session);
                    Console.WriteLine("EXE file not found: " + exeFilePath);
                    return ActionResult.Failure;
                }
            }
            catch (Exception ex)
            {
                SetupHelpers.StopProcess("FanatecService");
                session.Log("InstallFanatecService: Error: " + ex.Message);
                RemoveStartupEntry(session);
                //RollBackInstallation(session);
                return ActionResult.Failure;
            }
        }

