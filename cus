        [CustomAction]
        public static ActionResult UnInstallEndorUI(Session session)
        {
            try
            {
                CloseUIIfOpen();
                string targetPath = session.CustomActionData["InstallPath"];
                string targetDirectory = Path.Combine($@"{targetPath}", "FanatecUI", "UI");
                string desktopShortcut = Path.Combine($@"{Settings.desktopPath}", "Fanatec.lnk");

                if (System.IO.File.Exists(desktopShortcut))
                    System.IO.File.Delete(desktopShortcut);

                string programShortcut = Path.Combine($@"{Settings.programsPath}", "Fanatec.lnk");

                if (System.IO.File.Exists(programShortcut))
                    System.IO.File.Delete(programShortcut);

                if (Directory.Exists(targetDirectory))
                    Directory.Delete(targetDirectory, true);

                return ActionResult.Success;
            }
            catch (Exception ex)
            {
                session.Log("UnInstallEndorUI: Error: " + ex.Message);
                return ActionResult.Failure;
            }
        }

        private static void CloseUIIfOpen()
        {
            string processName = "Fanatec";
            Process[] processes = Process.GetProcessesByName(processName);
            if (processes.Length > 0)
            {
                foreach (Process process in processes)
                {

                    process.Kill();
                    process.WaitForExit(); // Wait for the process to exit
                }
            }
        }

        public static void RollBackInstallation(Session session)
        {
            UnInstallEndorUI(session);
            UnInstallFanatecService(session);
            //UnInstallGameControlService(session);
            UninstallMQTT(session);
        }

        public static void AddStartupEntry(Session session, string exeFilePath)
        {
            try
            {
                session.Log("Inside AddStartupEntry");
                using (RegistryKey key = Registry.LocalMachine.OpenSubKey("Software\\Microsoft\\Windows\\CurrentVersion\\Run", true))
                {
                    if (key != null)
                    {
                        string exePath = exeFilePath;
                        key.SetValue("FanatecService", $"{exePath}");
                    }
                }
            }
            catch (Exception ex)
            {
                session.Log("Failed AddStartupEntry");
            }
        }

        public static void RemoveStartupEntry(Session session)
        {
            try
            {
                session.Log("Inside RemoveStartupEntry");
                using (RegistryKey key = Registry.LocalMachine.OpenSubKey("Software\\Microsoft\\Windows\\CurrentVersion\\Run", true))
                {
                    if (key != null)
                    {
                        key.DeleteValue("FanatecService", false);
                    }
                }
            }
            catch (Exception ex)
            {
                session.Log("Failed RemoveStartupEntry");
            }
        }
