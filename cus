        [CustomAction]
        public static ActionResult InstallEndorUI(Session session)
        {
            try
            {
                string targetPath = session.CustomActionData["InstallPath"];
                string zipFilePath = Path.Combine($@"{targetPath}", "FanatecUI", "EndorUI.zip");
                string targetDirectory = Path.Combine($@"{targetPath}", "FanatecUI", "UI");

                session.Log("zipFilePath: " + zipFilePath);
                session.Log("targetDirectory: " + targetDirectory);

                if (Directory.Exists(targetDirectory))
                {
                    Directory.Delete(targetDirectory, true);
                }

                ZipFile.ExtractToDirectory(zipFilePath, targetDirectory);

                string exeFilePath = Path.Combine($@"{targetDirectory}", "Fanatec.exe");

                session.Log("exeFilePath: " + exeFilePath);
                var wshShell = new WshShell();
                var desktopShortcut = (IWshShortcut)wshShell.CreateShortcut(Path.Combine($@"{Settings.desktopPath}",
                                                                                         "Fanatec.lnk"));
                desktopShortcut.TargetPath = exeFilePath;

                session.Log("desktopShortcut: " + Path.Combine($@"{Settings.desktopPath}", "Fanatec.lnk"));

                desktopShortcut.Save();

                System.IO.File.Copy(Path.Combine($@"{Settings.desktopPath}", "Fanatec.lnk"),
                                    Path.Combine($@"{Settings.programsPath}", "Fanatec.lnk"),
                                    true);

                session.Log("CopyPath: " + Path.Combine($@"{Settings.programsPath}", "Fanatec.lnk"));

                return ActionResult.Success;
            }
            catch (Exception ex)
            {
                session.Log("InstallEndorUI: Error: " + ex.Message);
                //RollBackInstallation(session);
                return ActionResult.Failure;
            }
        }

        [CustomAction]
        public static ActionResult UninstallMQTT(Session session)
        {
            try
            {
                SetupHelpers.ExecuteEXE("sc.exe", "stop mosquitto");
                Thread.Sleep(3000);
                SetupHelpers.ExecuteEXE("sc.exe", "delete mosquitto force");
                Thread.Sleep(3000);

                string targetDirectory = Path.Combine($@"{Settings.programFilesPath}", "mosquitto");
                var installationPath = Path.Combine($@"{targetDirectory}", "Uninstall.exe");
                if (System.IO.File.Exists(installationPath))
                {
                    SetupHelpers.ExecuteEXE(installationPath, "/S");
                }

                SetupHelpers.WaitProcessTerminate("mosquitto", 60);

                if (Directory.Exists(targetDirectory))
                    Directory.Delete(targetDirectory, true);

                return ActionResult.Success;
            }
            catch (Exception ex)
            {
                session.Log("UninstallMQTT: Error: " + ex.Message);
                return ActionResult.Failure;
            }
        }

        [CustomAction]
        public static ActionResult UnInstallFanatecService(Session session)
        {
            try
            {
                string targetPath = session.CustomActionData["InstallPath"];
                string targetDirectory = Path.Combine($@"{targetPath}", "FanatecService", "Service");
                string exeFilePath = Path.Combine($@"{targetDirectory}", "FanatecService.exe");
                string trackerPath = Path.Combine($@"{Settings.publicFolderPath}", "Installer");

                if (System.IO.File.Exists(exeFilePath))
                {
                    //SetupHelpers.ExecuteEXE(exeFilePath, "uninstall");
                    //// Wait till uninstallation is through, EXE is unloaded and DLLs are unlocked
                    SetupHelpers.StopProcess("FanatecService");
                    SetupHelpers.WaitProcessTerminate("FanatecService", 60);
                    RemoveStartupEntry(session);

                }

                if (Directory.Exists(targetDirectory))
                    Directory.Delete(targetDirectory, true);
                try
                {
                    session.Log("Tracker Path: " + trackerPath);
                    // Find all .json files in the directory
                    var jsonFiles = Directory.GetFiles(trackerPath, "*.json");

                    foreach (var file in jsonFiles)
                    {
                        session.Log("Tracker File : " + file);
                        try
                        {
                            System.IO.File.Delete(file); // Attempt to delete each .json file
                        }
                        catch
                        {
                        }
                    }
                }
                catch
                {
                }
                return ActionResult.Success;
            }
            catch (Exception ex)
            {
                session.Log("UnInstallFanatecService: Error: " + ex.Message);
                return ActionResult.Failure;
            }
        }

